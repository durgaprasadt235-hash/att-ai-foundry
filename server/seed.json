  "docs": [
    {
      "id": "POL-001",
      "title": "Duplicate Billing Credit Policy",
      "body": "A duplicate charge is the same customer, same service, and same amount posted twice within 7 days under different invoice numbers. A billing credit may be proposed only after both posted charges are verified and linked to the customer account. A single valid charge is not a duplicate.",
      "updated": "2026-10-01"
    },
    {
      "id": "POL-002",
      "title": "Goodwill Credit Limits",
      "body": "A goodwill credit of $25 or less does not require second approval. A goodwill credit greater than $25 requires human approval. A goodwill credit greater than $100 requires supervisor approval.",
      "updated": "2026-10-01"
    },
    {
      "id": "POL-003",
      "title": "Roaming Charges",
      "body": "A roaming charge is valid when usage in the billed roaming region is verified against the customer account and the roaming rate. A single verified roaming charge does not qualify as duplicate billing. Disputed roaming charges require usage verification before credit review.",
      "updated": "2026-10-01"
    },
    {
      "id": "POL-004",
      "title": "Plan Change Processing",
      "body": "Unlimited Starter costs $65.00 and Unlimited Premium costs $87.40, a monthly difference of $22.40. Plan changes require customer authorization and an eligibility check. An approved plan change takes effect on the next billing cycle, and the confirmation must state that effective date.",
      "updated": "2026-10-01"
    },
    {
      "id": "POL-005",
      "title": "Case Handling Time Standard",
      "body": "The manual case-handling baseline is 38 minutes per case. Case records must include a customer reference, supporting evidence, a decision, and an audit trail. The baseline is a comparison standard, not a guaranteed resolution time.",
      "updated": "2026-10-01"
    },
    {
      "id": "POL-006",
      "title": "Outage Service Credit Policy",
      "body": "An outage service credit of $25 is available only if the outage lasts more than 4 hours and is confirmed in network status. An unconfirmed outage or one lasting 4 hours or less does not qualify. Record network confirmation before issuing a credit.",
      "updated": "2026-10-01"
    },
    {
      "id": "POL-007",
      "title": "Retention Save Offers",
      "body": "Retention save offers may include a credit of up to $25 and reactivation. Every save offer and reactivation requires human approval. Record the customer acceptance and approval before execution.",
      "updated": "2026-10-01"
    },
    {
      "id": "POL-008",
      "title": "Provisioning & Activation Policy",
      "body": "Provisioning requires an active account with an overdue balance of $100 or less. The required sequence is eligibility, order, provisioning, device activation, and confirmation. Suspended and closed accounts fail eligibility until restored to active status.",
      "updated": "2026-10-01"
    }
  ],
