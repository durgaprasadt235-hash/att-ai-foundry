# Telecom Project — environment variables.
# Copy to .env.local for local dev, or set as Vercel project environment
# variables (Production + Preview) after deploy. NEVER commit a real key.
# Demo mode needs NONE of these: without them the app runs on the synthetic
# seed + deterministic engine and says so. See docs/DEPLOYMENT.md.

# --- Live LLM (optional) ---
# Required only for live-LLM mode. Without it the agent is deterministic.
# Get it free (no card) in the Groq Console: console.groq.com
# Model used: openai/gpt-oss-120b. The key is read server-side only.
GROQ_API_KEY=

# --- Live carrier data source (optional) ---
# Required only when DATASOURCE=att. Get both from the carrier's fulfilment
# team (the team that owns the CRM / billing / usage APIs). Without them
# the app stays on the synthetic seed — `att` mode fails honestly rather
# than silently falling back to fake data.
# Base URL of the carrier API, e.g. https://api.internal.example.com/telecom/v1
ATT_API_BASE_URL=
# Bearer token for that API. Rotate it like any service credential.
ATT_API_KEY=

# --- Database (optional, reserved) ---
# Reserved for the future Postgres-backed store. NOTHING reads it yet:
# the demo stores state in the browser (localStorage) + the seed file.
# Set it when the fulfilment team provisions the database (see
# docs/DEPLOYMENT.md); until the store is wired, /api/health reports
# "configured but not yet wired" rather than pretending it is live.
DATABASE_URL=

# --- Data source mode (optional, default: seed) ---
# seed = synthetic demo data (20 customers, 66 ledger, 20 usage, 12 cases).
# att  = live carrier adapter (requires ATT_API_BASE_URL + ATT_API_KEY).
DATASOURCE=seed

# --- Login gate (optional, default: false) ---
# Disabled by default in the demo. Production uses Entra ID.
# AUTH_ENABLED=true turns on the gate; AUTH_CLIENT_ID + AUTH_ISSUER_URL
# are then required (the Entra ID app registration from the fulfilment
# team). Enabled without them shows an honest "auth not configured"
# state — never a fake login.
AUTH_ENABLED=false
AUTH_PROVIDER=entra-id
AUTH_CLIENT_ID=
AUTH_ISSUER_URL=

# --- Demo-grade rate limit (optional, default: 120) ---
# Requests per minute per client IP enforced by the in-memory guard in
# server/app.py and src/lib/api-utils.ts. Production rate limiting
# (60/min per caller) belongs at the edge — see docs/DEPLOYMENT.md.
RATE_LIMIT_PER_MINUTE=120
